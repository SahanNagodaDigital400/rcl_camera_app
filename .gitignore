.pytest_cache/
.ruff_cache/
.venv/
*.egg-info/

# Node / front end
node_modules/
dist/
coverage/

# Secrets — AGENTS.md Policy: never commit or hardcode a secret, test fixtures
# included. Environment or a secret store only.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

